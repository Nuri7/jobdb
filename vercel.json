{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://sfdppcdzvwmdbqlehihz.supabase.co/functions/v1/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sfdppcdzvwmdbqlehihz.supabase.co/functions/v1/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
